// Chứa cấu hình

{

  // DB connection
  // Luồng: appsettings.json -> Program.cs -> DbContext -> SQL Server
  "ConnectionStrings": {
    "QuizDb": "Server=(localdb)\\MSSQLLocalDB;Database=QuizAppDb;Trusted_Connection=True;TrustServerCertificate=True"
  },

  // Cấu hình JWT dùng cho UC01/UC02/UC03 (Program.cs -> Security/JwtTokenService.cs)
  // "Key" KHÔNG đặt ở đây: dùng user-secrets (dotnet user-secrets set "Jwt:Key" "...") hoặc biến môi trường Jwt__Key.
  // API từ chối khởi động nếu Key thiếu hoặc ngắn hơn 32 byte. Development có key riêng trong appsettings.Development.json.
  "Jwt": {
    "Issuer": "QuizApp.Api",
    "Audience": "QuizApp.Client",
    "ExpiresMinutes": 480
  },

  // Serilog: log có cấu trúc ra console + file (logs/quizapp-<yyyyMMdd>.log, giữ 14 ngày).
  // Mỗi request 1 dòng (UseSerilogRequestLogging); lỗi 500 kèm TraceId để đối chiếu với response.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/quizapp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {RequestPath} {RequestId}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",

  // Origin của frontend được phép gọi API (CORS). Development: xem appsettings.Development.json.
  "Cors": {
    "Origins": []
  }
}
