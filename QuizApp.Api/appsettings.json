// Chứa cấu hình

{

  // DB connection
  // Luồng: appsettings.json -> Program.cs -> DbContext -> SQL Server
  "ConnectionStrings": {
    "QuizDb": "Server=(localdb)\\MSSQLLocalDB;Database=QuizAppDb;Trusted_Connection=True;TrustServerCertificate=True"
  },

  // Cấu hình JWT dùng cho UC01/UC02/UC03 (Program.cs -> Security/JwtTokenService.cs)
  // ĐỔI "Key" sang một chuỗi bí mật khác (>= 32 ký tự) trước khi deploy thật.
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "QuizApp.Api",
    "Audience": "QuizApp.Client",
    "ExpiresMinutes": 480
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
